# Copy to .env and fill in your own values. .env is gitignored.
#   cp .env.example .env

# --- Google Cloud -----------------------------------------------------------
# BigQuery project the queries run against. Also substituted for {{BQ_PROJECT_ID}}
# in SQL files and configs.
GOOGLE_CLOUD_PROJECT=my-gcp-project

# Bucket prefix that `gcs_path` in a config is appended to. Also substituted for
# {{GCS_BUCKET_PREFIX}}. No trailing slash.
GCS_BUCKET_PREFIX=gs://my-bucket/dev

# Service-account JSON with BigQuery + GCS read access. DuckDB reuses these same
# credentials to reach GCS. Inside the container this is the mount path below.
GOOGLE_APPLICATION_CREDENTIALS=/home/appuser/.config/gcloud/application_default_credentials.json

# --- Postgres target --------------------------------------------------------
# docker-compose.yaml assembles these into the --postgres_conn DSN.
# For IAM auth, DB_USER is the service-account email with .gserviceaccount.com
# stripped, and DB_PASSWORD is left empty.
DB_USER=app
DB_PASSWORD=app
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=postgres

# --- DuckDB limits (optional) ----------------------------------------------
# Set these when running under a container memory limit; DuckDB otherwise sizes
# itself against the host's RAM rather than the pod's allowance.
# DUCKDB_MEMORY_LIMIT=4GB
# DUCKDB_THREADS=4
# DUCKDB_TEMP_DIRECTORY=/tmp/duckdb
